---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  noindex = false
} = Astro.props;

const siteUrl = 'https://airconditioningrepaircanongaparkca.us';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const pageTitle = title.includes('Air Conditioning') || title.includes('HVAC') 
  ? title 
  : `${title} | Air Conditioning Repair Canoga Park CA`;
const phone = '(818) 704-1234';
const phoneLink = 'tel:+18187041234';
const businessName = 'Air Conditioning Repair Canoga Park CA';
const address = '7232 Canoga Ave, Canoga Park, CA 91303, USA';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={businessName} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Home - Air Conditioning Repair Canoga Park CA">
          AC Repair Canoga Park
          <span>Local HVAC Experts</span>
        </a>
        
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" id="nav-toggle">
          ☰
        </button>
        
        <nav class="nav" id="main-nav" aria-label="Main navigation">
          <ul class="nav-list">
            <li><a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Home</a></li>
            <li class="dropdown" id="services-dropdown">
              <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false" id="services-btn">
                Services ▾
              </button>
              <div class="dropdown-menu" role="menu" aria-label="Services menu">
                <a href="/services/" role="menuitem">All Services</a>
                <a href="/services/air-conditioner-repair/" role="menuitem">AC Repair</a>
                <a href="/services/ac-installation/" role="menuitem">AC Installation</a>
                <a href="/services/furnace-repair/" role="menuitem">Furnace Repair</a>
                <a href="/services/furnace-installation/" role="menuitem">Furnace Installation</a>
                <a href="/services/heat-pump-repair/" role="menuitem">Heat Pump Repair</a>
                <a href="/services/heat-pump-installation/" role="menuitem">Heat Pump Installation</a>
                <a href="/services/hvac-maintenance/" role="menuitem">HVAC Maintenance</a>
                <a href="/services/duct-cleaning/" role="menuitem">Duct Cleaning</a>
                <a href="/services/thermostat-installation/" role="menuitem">Thermostat Install</a>
                <a href="/services/emergency-hvac-repair/" role="menuitem">Emergency Repair</a>
                <a href="/services/mini-split-installation/" role="menuitem">Mini Split</a>
                <a href="/services/indoor-air-quality/" role="menuitem">Air Quality</a>
                <a href="/services/ac-tune-up/" role="menuitem">AC Tune-Up</a>
                <a href="/services/furnace-tune-up/" role="menuitem">Furnace Tune-Up</a>
                <a href="/services/refrigerant-recharge/" role="menuitem">Refrigerant</a>
                <a href="/services/ductwork-repair/" role="menuitem">Ductwork Repair</a>
                <a href="/services/commercial-hvac/" role="menuitem">Commercial HVAC</a>
                <a href="/services/smart-thermostat/" role="menuitem">Smart Thermostat</a>
                <a href="/services/air-filter-replacement/" role="menuitem">Filter Replacement</a>
                <a href="/services/zoning-systems/" role="menuitem">Zoning Systems</a>
              </div>
            </li>
            <li><a href="/service-areas/" class={Astro.url.pathname.startsWith('/service-areas') ? 'active' : ''}>Service Areas</a></li>
            <li><a href="/about/" class={Astro.url.pathname === '/about/' || Astro.url.pathname === '/about' ? 'active' : ''}>About</a></li>
            <li><a href="/blog/" class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>Blog</a></li>
            <li><a href="/contact/" class={Astro.url.pathname === '/contact/' || Astro.url.pathname === '/contact' ? 'active' : ''}>Contact</a></li>
          </ul>
          <a href={phoneLink} class="btn btn-call" style="margin-left: 12px;">
            {phone}
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <h3>{businessName}</h3>
            <p style="margin-bottom: 12px;">{address}</p>
            <p><a href={phoneLink}>{phone}</a></p>
            <p style="margin-top: 8px;"><a href="mailto:info@airconditioningrepaircanongaparkca.us">info@airconditioningrepaircanongaparkca.us</a></p>
          </div>
          <div class="footer-col">
            <h3>Services</h3>
            <ul>
              <li><a href="/services/air-conditioner-repair/">AC Repair</a></li>
              <li><a href="/services/ac-installation/">AC Installation</a></li>
              <li><a href="/services/furnace-repair/">Furnace Repair</a></li>
              <li><a href="/services/hvac-maintenance/">HVAC Maintenance</a></li>
              <li><a href="/services/emergency-hvac-repair/">Emergency Repair</a></li>
              <li><a href="/services/">View All Services</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3>Service Areas</h3>
            <ul>
              <li><a href="/service-areas/canoga-park/">Canoga Park</a></li>
              <li><a href="/service-areas/winnetka/">Winnetka</a></li>
              <li><a href="/service-areas/reseda/">Reseda</a></li>
              <li><a href="/service-areas/chatsworth/">Chatsworth</a></li>
              <li><a href="/service-areas/woodland-hills/">Woodland Hills</a></li>
              <li><a href="/service-areas/">All Areas</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3>Company</h3>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} {businessName}. All rights reserved.</p>
          <p style="margin-top: 8px; font-size: 0.85rem;">Serving Canoga Park, CA and surrounding San Fernando Valley communities.</p>
        </div>
      </div>
    </footer>

    <a href={phoneLink} class="btn btn-call sticky-call" aria-label="Call us now">
      📞 Call Now
    </a>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('main-nav');
      const servicesBtn = document.getElementById('services-btn');
      const servicesDropdown = document.getElementById('services-dropdown');

      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      }

      if (servicesBtn && servicesDropdown) {
        servicesBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = servicesDropdown.classList.toggle('open');
          servicesBtn.setAttribute('aria-expanded', String(isOpen));
        });
      }

      // Close mobile nav on outside click
      document.addEventListener('click', (e) => {
        if (nav && nav.classList.contains('open') && !nav.contains(e.target as Node) && e.target !== toggle) {
          nav.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
