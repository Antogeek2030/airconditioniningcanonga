---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

const phone = '(818) 704-1234';
const phoneLink = 'tel:+18187041234';
const featured = services.slice(0, 6);
---

<BaseLayout
  title="Air Conditioning Repair Canoga Park CA | Local HVAC Experts"
  description="Trusted air conditioning repair and HVAC services in Canoga Park, CA. Fast AC repair, furnace service, installations, and maintenance. Call (818) 704-1234."
  canonical="/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Air Conditioning Repair in Canoga Park, CA</h1>
        <p>
          When your AC fails or your furnace needs attention, local technicians are ready to help.
          Honest diagnostics, clear pricing, and reliable repairs for homes across Canoga Park and nearby communities.
        </p>
        <div class="hero-actions">
          <a href={phoneLink} class="btn btn-call">📞 Call {phone}</a>
          <a href="/contact/" class="btn btn-outline">Request Service Online</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <div class="trust-bar">
    <div class="container">
      <div class="trust-items">
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Local Canoga Park Team
        </div>
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Prompt Scheduling
        </div>
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Clear Upfront Pricing
        </div>
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Residential & Light Commercial
        </div>
      </div>
    </div>
  </div>

  <!-- Services overview -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">HVAC Services We Provide</h2>
      <p class="section-subtitle">
        From emergency AC repair to planned system replacements, we handle the heating and cooling needs of Canoga Park homes.
      </p>
      <div class="grid-3">
        {featured.map(s => (
          <article class="card">
            <h3>{s.shortTitle}</h3>
            <p>{s.intro.slice(0, 140)}...</p>
            <a href={`/services/${s.slug}/`}>Learn more →</a>
          </article>
        ))}
      </div>
      <p class="text-center mt-4">
        <a href="/services/" class="btn btn-primary">View All Services</a>
      </p>
    </div>
  </section>

  <!-- Trust / why us -->
  <section class="section" style="background: var(--color-light);">
    <div class="container">
      <h2 class="section-title">Why Homeowners Call Us</h2>
      <p class="section-subtitle">
        We focus on straightforward service: diagnose carefully, explain options clearly, and complete approved work with care.
      </p>
      <div class="grid-2">
        <div class="card">
          <h3>Local Knowledge</h3>
          <p>
            Based in Canoga Park, we understand the climate demands of the San Fernando Valley and the types of systems commonly installed in area homes.
          </p>
        </div>
        <div class="card">
          <h3>Honest Communication</h3>
          <p>
            You receive a clear description of what we find and what it will cost before major work begins. No pressure—just information to help you decide.
          </p>
        </div>
        <div class="card">
          <h3>Quality Workmanship</h3>
          <p>
            Repairs and installations are completed carefully, with attention to manufacturer guidelines, safety, and long-term reliability.
          </p>
        </div>
        <div class="card">
          <h3>Convenient Scheduling</h3>
          <p>
            We work to offer appointment windows that fit your day and prioritize urgent no-heat or no-cool situations whenever possible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews (original, not fake stats) -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">What Neighbors Say</h2>
      <p class="section-subtitle">
        Feedback from homeowners we have served in and around Canoga Park.
      </p>
      <div class="grid-3">
        <blockquote class="review-card">
          <div class="review-stars" aria-label="5 stars">★★★★★</div>
          <p class="review-text">
            “Our AC stopped cooling on a Friday afternoon. They came out the same day, found a bad capacitor, and had us running again before evening. Straightforward and professional.”
          </p>
          <footer>
            <div class="review-author">Maria R.</div>
            <div class="review-location">Canoga Park</div>
          </footer>
        </blockquote>
        <blockquote class="review-card">
          <div class="review-stars" aria-label="5 stars">★★★★★</div>
          <p class="review-text">
            “Needed a new thermostat that worked with our heat pump. The technician explained the options, installed it cleanly, and made sure the app was set up before leaving.”
          </p>
          <footer>
            <div class="review-author">James T.</div>
            <div class="review-location">Winnetka</div>
          </footer>
        </blockquote>
        <blockquote class="review-card">
          <div class="review-stars" aria-label="5 stars">★★★★★</div>
          <p class="review-text">
            “Annual maintenance was thorough. They cleaned the outdoor unit, checked everything, and left a simple report. No upselling—just solid service.”
          </p>
          <footer>
            <div class="review-author">Susan K.</div>
            <div class="review-location">Reseda</div>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Need AC or Heating Help Today?</h2>
      <p>
        Call for service in Canoga Park and surrounding neighborhoods. We are ready to diagnose the problem and restore your comfort.
      </p>
      <a href={phoneLink} class="btn btn-call" style="background: var(--color-secondary); font-size: 1.15rem;">
        Call {phone}
      </a>
      <p style="margin-top: 16px;">
        <a href="/contact/" style="color: white; text-decoration: underline;">Or send a service request online</a>
      </p>
    </div>
  </section>
</BaseLayout>
