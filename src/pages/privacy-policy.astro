---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | Air Conditioning Repair Canoga Park CA"
  description="Privacy policy for airconditioningrepaircanongaparkca.us. How we handle information submitted through our website."
  canonical="/privacy-policy/"
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <span>Privacy Policy</span>
      </nav>
      <h1>Privacy Policy</h1>
      <p>Last updated: November 2025</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width: 720px; line-height: 1.7;">
      <p style="margin-bottom: 20px; color: var(--color-muted);">
        This privacy policy describes how Air Conditioning Repair Canoga Park CA (“we,” “us”) handles information collected through the website airconditioningrepaircanongaparkca.us.
      </p>

      <h2 style="font-size: 1.25rem; margin: 28px 0 12px;">Information We Collect</h2>
      <p style="margin-bottom: 16px; color: var(--color-muted);">
        When you use our contact form, we collect the information you provide: name, phone number, email address (if given), service interest, and message content. We use a third-party form service (Web3Forms) to process submissions.
      </p>
      <p style="margin-bottom: 16px; color: var(--color-muted);">
        Like most websites, our hosting provider may collect standard server logs such as IP address, browser type, and pages visited. We do not use this data to identify individual visitors for marketing purposes.
      </p>

      <h2 style="font-size: 1.25rem; margin: 28px 0 12px;">How We Use Information</h2>
      <p style="margin-bottom: 16px; color: var(--color-muted);">
        Contact form submissions are used solely to respond to your service requests and related questions. We do not sell personal information.
      </p>

      <h2 style="font-size: 1.25rem; margin: 28px 0 12px;">Third-Party Services</h2>
      <p style="margin-bottom: 16px; color: var(--color-muted);">
        Form submissions are processed by Web3Forms. Their privacy practices are governed by their own policies. Our site is hosted on Cloudflare Pages.
      </p>

      <h2 style="font-size: 1.25rem; margin: 28px 0 12px;">Data Retention</h2>
      <p style="margin-bottom: 16px; color: var(--color-muted);">
        We retain contact form messages as long as needed to provide service and for reasonable business records. You may request deletion of your submitted information by contacting us.
      </p>

      <h2 style="font-size: 1.25rem; margin: 28px 0 12px;">Contact</h2>
      <p style="margin-bottom: 16px; color: var(--color-muted);">
        Questions about this policy may be sent to info@airconditioningrepaircanongaparkca.us or by calling the number listed on this website.
      </p>
    </div>
  </section>
</BaseLayout>
